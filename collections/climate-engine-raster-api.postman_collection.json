            },
            "url": {
              "path": [
                "raster",
                "mapid",
                "values"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "dataset",
                  "value": "GRIDMET",
                  "description": "Dataset name (e.g. GRIDMET, ERA5, MODIS, CHIRPS)."
                },
                {
                  "disabled": false,
                  "key": "variable",
                  "value": "tmmn, tmmx",
                  "description": "Comma-separated variable name(s)."
                },
                {
                  "disabled": false,
                  "key": "temporal_statistic",
                  "value": "<string>",
                  "description": "Temporal reducer applied across the date range (e.g. mean, total)."
                },
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<string>",
                  "description": "Start date (YYYY-MM-DD)."
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<string>",
                  "description": "End date (YYYY-MM-DD)."
                },
                {
                  "disabled": false,
                  "key": "bounding_box",
                  "value": "<string>",
                  "description": "Optional bounding box to constrain the rendered region."
                },
                {
                  "disabled": false,
                  "key": "colormap_min_max",
                  "value": "<string>",
                  "description": "Min,max values for the color map."
                },
                {
                  "disabled": false,
                  "key": "colormap_palette",
                  "value": "<string>",
                  "description": "Comma-separated hex colors for the color map palette."
                }
